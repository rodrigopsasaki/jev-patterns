{
  "name": "jev-patterns",
  "version": "0.2.0",
  "description": "Human-readable interpretations of Jev probability distributions",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.14"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest --changed",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/test-package.mjs",
    "test:package:smoke": "node scripts/test-package.mjs --smoke",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check": "node scripts/check.mjs --changed",
    "check:affected": "node scripts/check.mjs --affected",
    "check:full": "node scripts/check.mjs --full",
    "check:plan": "node scripts/check.mjs --changed --plan",
    "demo": "node examples/shapes.ts",
    "demo:distributions": "node examples/distributions.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.consumer.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run check:full && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "5.0.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigopsasaki/jev-patterns.git"
  },
  "homepage": "https://github.com/rodrigopsasaki/jev-patterns#readme",
  "bugs": {
    "url": "https://github.com/rodrigopsasaki/jev-patterns/issues"
  },
  "keywords": [
    "jev",
    "typesafe",
    "probability",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
